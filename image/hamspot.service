[Unit]
Description=HamSpot HTTPS control center
After=network.target hamspot-firstboot.service
Requires=hamspot-firstboot.service
[Service]
User=hamspot
Group=hamspot
SupplementaryGroups=systemd-journal
WorkingDirectory=/opt/hamspot
ExecStart=/usr/bin/python3 /opt/hamspot/app/server.py
Restart=on-failure
RestartSec=3
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/hamspot /run/lock
[Install]
WantedBy=multi-user.target
